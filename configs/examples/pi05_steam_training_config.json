{
    "dataset_mixture": {
        "datasets": [
            {
                "repo_id": "REPLACE_WITH_EXPERT_REPO_ID",
                "root": "REPLACE_WITH_EXPERT_DATASET_ROOT"
            },
            {
                "repo_id": "REPLACE_WITH_NON_EXPERT_REPO_ID",
                "root": "REPLACE_WITH_NON_EXPERT_DATASET_ROOT"
            }
        ],
        "weights": [1.0, 1.0],
        "action_freq": 30.0,
        "image_resample_strategy": "nearest",
        "vector_resample_strategy": "nearest"
    },
    "policy": {
        "type": "pi05",
        "pretrained_path": "REPLACE_WITH_PI05_CHECKPOINT",
        "n_obs_steps": 1,
        "normalization_mapping": {
            "VISUAL": "IDENTITY",
            "STATE": "MIN_MAX",
            "ACTION": "MIN_MAX"
        },
        "chunk_size": 32,
        "n_action_steps": 32,
        "advantage": "use",
        "advantage_threshold": 0.5,
        "cfg_dropout": 0.1,
        "guidance_scale": 1.0
    },
    "output_dir": "outputs/pi05_steam",
    "seed": 1000,
    "resolution": [224, 224],
    "num_cams": 2,
    "max_state_dim": 32,
    "max_action_dim": 32,
    "action_chunk": 32,
    "loss_weighting": {
        "MSE": 10.0,
        "CE": 1.0
    },
    "num_workers": 8,
    "batch_size": 64,
    "gradient_accumulation_steps": 4,
    "dataloader_batch_size": 16,
    "prefetch_factor": 4,
    "steps": 30000,
    "log_freq": 50,
    "save_checkpoint": true,
    "save_freq": 5000,
    "val_freq": 0,
    "ema_decay": 0.99,
    "use_policy_training_preset": true,
    "trace_nans": false,
    "wandb": {
        "enable": false,
        "project": "pi05-steam",
        "notes": "PI0.5 advantage-conditioned offline RL with STEAM labels"
    }
}
